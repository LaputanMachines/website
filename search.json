---
layout: null
---
[
  {% for post in site.posts %}
    {%- comment -%}
      The transit lines the post rides, as on the homepage ("Development / AI"),
      so a search for a line or tag finds its posts.
    {%- endcomment -%}
    {%- assign line_names = "" -%}
    {%- for line in site.data.settings.transit.lines -%}
      {%- for tag in line.tags -%}
        {%- unless post.tags contains tag %}{% continue %}{% endunless -%}
        {%- capture line_names %}{{ line_names }}{% if line_names != "" %} / {% endif %}{{ line.name }}{% endcapture -%}
        {%- break -%}
      {%- endfor -%}
    {%- endfor -%}

    {%- comment -%} A few words shown under the title; the first paragraph when there is no description. {%- endcomment -%}
    {%- assign preview = post.description | default: post.excerpt | strip_html | normalize_whitespace | truncatewords: 16 %}
    {
      "title"  : "{{ post.title | escape }}",
      "url"    : "{% if post.external_url %}{{ post.external_url }}{% else %}{{ site.baseurl }}{{ post.url }}{% endif %}",
      {% if post.external_url %}"external": "{{ post.external_site | escape }}",{% endif %}
      "tags"   : {{ line_names | escape | jsonify }},
      "preview": {{ preview | escape | jsonify }},
      "date"   : "{{ post.date | date_to_long_string }}"
    } {% unless forloop.last %},{% endunless %}
  {% endfor %}
]
